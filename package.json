{
  "name": "indopolaris",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:verify-constraints": "tsx scripts/verify-constraints.ts",
    "db:reset": "prisma migrate reset --force",
    "db:pglite": "node scripts/pglite-server.mjs",
    "media:placeholders": "node scripts/generate-placeholder-media.mjs",
    "setup": "npm run media:placeholders && npm run db:generate && npm run db:migrate && npm run db:seed",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ml": "node scripts/smoke-ml.mjs",
    "bootstrap": "bash scripts/bootstrap.sh",
    "ml:download": "cd ml && .venv/bin/python scripts/download_dataset.py",
    "ml:train": "bash scripts/with-env.sh ml .venv/bin/python scripts/train_ensemble.py",
    "ml:test": "cd ml && .venv/bin/python -m pytest",
    "ml:simulate": "node scripts/with-db.mjs -- bash -c 'cd ml && set -a && . ../.env && set +a && .venv/bin/python scripts/simulate_engagement.py --base-url http://127.0.0.1:8000 \"$@\"' --",
    "test:ml-client": "node --conditions=react-server --import tsx --test scripts/ml-client.test.ts",
    "ml:serve": "bash scripts/with-env.sh ml .venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "ml:types": "cd ml && .venv/bin/python scripts/export_openapi.py && cd .. && openapi-typescript ml/openapi.json -o src/lib/ml-openapi.d.ts",
    "verify:db": "npm run db:migrate && npm run db:seed",
    "verify:all": "npm run ml:test && npm run test:ml-client && npm run ml:types && npm run verify:db && npm run verify"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "framer-motion": "13.4.4",
    "leaflet": "1.9.4",
    "minio": "8.0.7",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.7",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "1.9.22",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
