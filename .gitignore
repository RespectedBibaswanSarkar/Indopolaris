# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# --- IndoPolaris -------------------------------------------------------------
# PGlite dev-fallback database directory (recreated by `npm run db:pglite`)
/.pglite

# Local object-storage driver (`STORAGE_DRIVER=local`). Uploaded files and
# placeholder objects live here; never commit a scientist's data.
/.local-storage

# Prisma generated client. Regenerated by the `postinstall` script and by
# `npm run db:generate`, so there is no reason to commit it.
/src/generated

# Seeded placeholder media is generated by `npm run media:placeholders`.
# Commit it instead if you would rather `git clone` be enough to run the app
# without a generate step.
/public/media/seed

# --- ML service (Phase 2) ----------------------------------------------------
# Recreated by `npm run ml:setup` (called from `npm run bootstrap`).
/ml/.venv
/ml/**/__pycache__

# Training corpus, downloaded by `npm run ml:download`. It is a rebuildable copy
# of NASA GES DISC's publications-research-areas dataset, not source.
/ml/data

# Trained artifacts. `ml/models/metrics.json` *is* committed — it is the
# accuracy/F1 evidence the phase report cites. The joblib is not: it is a
# deterministic function of the corpus and the pinned scikit-learn version, so
# `npm run ml:train` reproduces it byte-for-byte semantics without a ~15 MB
# binary in the history. Run bootstrap before `docker compose up`, because the
# image copies this directory in.
/ml/models/*.joblib

# NOTE: `ml/openapi.json` and `src/lib/ml-openapi.d.ts` are deliberately
# committed. They are the Node/Python contract, small enough to review in a
# diff, and committing them means `npm run build` works on a fresh clone with
# no Python toolchain. `npm run ml:types` regenerates both; bootstrap runs it
# so a contract change shows up as a diff instead of a runtime surprise.
